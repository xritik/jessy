# Copy this file to .env and fill in real values
GROQ_API_KEY_1=your_key_here
GROQ_API_KEY_2=your_key_here
GROQ_API_KEY_3=your_key_here
GROQ_API_KEY_4=your_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TOOL_MODEL=openai/gpt-oss-20b


# Backend server config
HOST=0.0.0.0
PORT=8000

# CORS - the frontend dev origin
FRONTEND_ORIGIN=http://localhost:5173

# Agent safety limit
MAX_AGENT_STEPS=12

YOUTUBE_API_KEY = "your_actual_key_here"

# Whisper transcription model (Groq-hosted)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_AUDIO_RPM_LIMIT=20

PIPER_VOICE_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
